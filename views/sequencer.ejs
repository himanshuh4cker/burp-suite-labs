<%- include('partials/header') %>

<% 
  const notes = {
    objective: "Analyze session token randomness using Burp Sequencer by capturing sequential, predictable cookie patterns.",
    workflow: [
      "Open Burp Suite and navigate to Proxy > HTTP history.",
      "Click the 'Generate Session Cookie' button on this page. Find the GET /sequencer/generate request in Burp's history.",
      "Right-click the request and select 'Send to Sequencer'.",
      "Go to the Sequencer tab. In the Select Request section, select the GET /sequencer/generate node.",
      "In the Token Location section, select the 'Cookie: SESSION-TOKEN' radio button.",
      "Click 'Start live capture' in the bottom right corner.",
      "Watch Sequencer send requests. Let it capture at least 100 to 200 tokens (usually 10,000 are needed for full statistical analysis, but the sequential pattern will be immediately obvious).",
      "Analyze the results: you will see that the entropy is 0 bits (completely predictable!). The JSON payload response from /sequencer/generate contains the flag: FLAG{SEQUENCER_PREDICTABLE_TOKENS}."
    ],
    whatToSay: [
      "Welcome to the Sequencer Lab! Session tokens must be cryptographically secure and highly random.",
      "If session tokens are predictable, an attacker can guess the session ID of another logged-in user and hijack their account without knowing their password.",
      "Burp Sequencer is a statistical tool that analyzes the randomness (entropy) of a sample of tokens.",
      "Here, the server generates sequential IDs: SESSION-1001, SESSION-1002, etc.",
      "By feeding these to Sequencer, the tool immediately detects a simple linear progression, reporting extremely low randomness."
    ],
    mistakes: [
      "Running live capture on the wrong parameter (e.g. testing the response HTML length instead of the session cookie value).",
      "Stopping the live capture too early: Sequencer needs a small batch to start plotting, but let it run for a few seconds to see the graph clearly.",
      "Not understanding that Sequencer is built to send automated requests. (Don't run Sequencer against production sites without permission, it generates high traffic!)"
    ],
    concepts: [
      "Burp Sequencer Operations",
      "Predictable Session Management",
      "Entropy and Randomness Analysis",
      "Session Hijacking Theory"
    ]
  };
%>

<div class="lab-layout">
  
  <!-- Left Workspace -->
  <div class="lab-workspace">
    <div class="card" style="margin-bottom: 1.5rem;">
      <h2 style="font-size: 1.5rem; color: var(--accent-cyan); margin-bottom: 0.5rem;">Lab 8: Predictable Session Tokens</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
        Examine how Burp Sequencer tests the quality of randomness in session cookies to prevent token hijacking.
      </p>

      <div class="alert-box alert-info">
        <strong>Mission:</strong> Trigger the session generator endpoint. Analyze the sequence structure inside Burp Sequencer, and submit the flag returned inside the token response JSON.
      </div>

      <!-- Token Generator Panel -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem; flex-wrap: wrap;">
        
        <!-- Live Request Trigger -->
        <div class="card" style="background: var(--bg-darker);">
          <h3 style="font-size: 1.1rem; color: var(--accent-cyan); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1rem;">
            🔋 Interactive Cookie Generator
          </h3>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
            Click to issue a new session token. The server will set a cookie <code>SESSION-TOKEN</code> and return the payload JSON.
          </p>

          <button class="btn btn-primary btn-sm" onclick="generateSingleToken()">
            Generate Session Cookie
          </button>
          
          <div class="http-inspector" style="margin-top: 1rem;">
            <div class="inspector-title">Active Response Headers / Body:</div>
            <pre id="singleTokenConsole" style="padding: 0.75rem; font-size: 0.75rem; color: var(--text-muted); max-height: 140px; overflow-y: auto;">Console empty.</pre>
          </div>
        </div>

        <!-- Copy-Paste Batch Tool -->
        <div class="card" style="background: var(--bg-darker);">
          <h3 style="font-size: 1.1rem; color: var(--accent-purple); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; margin-bottom: 1rem;">
            📦 Clipboard Batch Exporter
          </h3>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
            If you want to manually paste tokens into Sequencer, click below to generate a batch of 100 sequential tokens instantly.
          </p>

          <button class="btn btn-secondary btn-sm" onclick="generateBatchTokens()">
            Batch Generate 100 Tokens
          </button>

          <textarea id="batchTextArea" class="form-textarea" readonly style="margin-top: 1rem; font-family: monospace; font-size: 0.8rem; height: 120px;" placeholder="Batch output will print here..."></textarea>
        </div>

      </div>

    </div>

    <!-- Hints Section -->
    <div class="hint-accordion">
      <button class="hint-trigger">
        <span>💡 Need a hint?</span>
        <span class="hint-icon">▼</span>
      </button>
      <div class="hint-content">
        <p>1. Open Burp, click **Generate Session Cookie**.</p>
        <p style="margin-top: 0.5rem;">2. Go to **Proxy > HTTP history** and locate the request to <code>/sequencer/generate</code>.</p>
        <p style="margin-top: 0.5rem;">3. Right-click and choose **Send to Sequencer**.</p>
        <p style="margin-top: 0.5rem;">4. In Sequencer, select the **SESSION-TOKEN** cookie, click **Start Live Capture**, and watch the entropy score. The JSON response displays the flag: <code>FLAG{SEQUENCER_PREDICTABLE_TOKENS}</code>.</p>
      </div>
    </div>

    <!-- Flag Submission -->
    <%- include('partials/flag_submission', { lab: 'sequencer' }) %>
  </div>

  <!-- Right YouTube Guide -->
  <%- include('partials/youtube_drawer', { notes: notes }) %>

</div>

<!-- Client script -->
<script>
  async function generateSingleToken() {
    const consoleEl = document.getElementById('singleTokenConsole');
    consoleEl.textContent = "Requesting token...";
    
    try {
      const res = await fetch('/sequencer/generate');
      const data = await res.json();
      consoleEl.textContent = `HTTP/1.1 200 OK\nSet-Cookie: SESSION-TOKEN=${data.token}\nContent-Type: application/json\n\n${JSON.stringify(data, null, 2)}`;
    } catch(e) {
      consoleEl.textContent = "Error connecting to server.";
    }
  }

  async function generateBatchTokens() {
    const area = document.getElementById('batchTextArea');
    area.value = "Generating batch...";
    
    let list = [];
    try {
      // Simulate fetching 100 tokens sequentially
      for (let i = 0; i < 100; i++) {
        const res = await fetch('/sequencer/generate');
        const data = await res.json();
        list.push(data.token);
      }
      area.value = list.join('\n');
    } catch(e) {
      area.value = "Batch generation failed.";
    }
  }
</script>

<%- include('partials/footer') %>
